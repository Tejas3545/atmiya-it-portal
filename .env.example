# ==============================================================================
# Atmiya Attendance Portal — Environment Configuration
# ==============================================================================

PORT=5000

# ------------------------------------------------------------------------------
# Google Service Account Credentials
# ------------------------------------------------------------------------------
# In production (e.g. Render Dashboard):
# Paste the entire content of atmiya-foet-portal-*.json as a single line string.
# Locally: If atmiya-foet-portal-*.json is in the project root, app.py detects it automatically.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# Google Sheet / Drive URLs for each Department
# ------------------------------------------------------------------------------
# Share each sheet or uploaded Excel file with:
# foet-portal@atmiya-foet-portal.iam.gserviceaccount.com (Viewer access)
#
# Then paste their shareable link here:
GOOGLE_SHEET_URL_IT=https://docs.google.com/spreadsheets/d/1TCHWU28MbUThEFCrqB4iTuL6mbgV9VbP/edit
GOOGLE_SHEET_URL_CSE=
GOOGLE_SHEET_URL_CE=
GOOGLE_SHEET_URL_CIVIL=
GOOGLE_SHEET_URL_MECH=
GOOGLE_SHEET_URL_ELEC=
